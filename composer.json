{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "narsil/base",
    "type": "library",
    "keywords": [
        "ui",
        "base-ui",
        "shadcn",
        "tailwind"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "laravel/ai": "^1.0",
        "laravel/fortify": "^1.37",
        "laravel/framework": "^13.24",
        "laravel/horizon": "^5.48",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "gehrisandro/tailwind-merge-laravel": "^1.4",
        "livewire/livewire": "^4.0",
        "symfony/models-dev": "^174.0",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Narsil\\Base\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Narsil\\Base\\ServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}